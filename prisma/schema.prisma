generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Agent {
  id                  String           @id @default(cuid())
  agentId             String           @unique
  phone               String           @unique
  email               String?          @unique
  emailVerified       Boolean          @default(false)
  emailAlertsOn       Boolean          @default(true) // the agent's switch for sign-in and payment emails; acts only on a verified email
  emailVerifyToken    String?          @unique
  name                String
  location            String
  address             String?
  dob                 String?
  gender              String?
  bvn                 String?
  nin                 String?
  nokName             String?
  nokPhone            String?
  photoUrl            String?
  nfcCard             String?
  floatLimit          Float?
  password            String
  walletBalance       Float            @default(0)
  commissionBalance   Float            @default(0)
  requiredDocs        String           @default("[]")
  status              String           @default("Active")
  loginAttempts       Int              @default(0)
  lockedAt            DateTime?
  tokenVersion        Int              @default(0)
  profileUnlocked     Boolean          @default(false)
  transactionPin      String?
  unlockToken         String?
  unlockTokenExpiry   DateTime?
  boundDeviceId       String?
  bankCode            String?
  bankName            String?
  accountNumber       String?
  accountName         String?
  /// When the agent last opened their notifications; newer ones count as new on the bell.
  notificationsSeenAt DateTime?
  createdAt           DateTime         @default(now())
  customers           Customer[]
  customerRequests    CustomerRequest[]
  transactions        Transaction[]
  loans               Loan[]
  subAgents           SubAgent[]
  reports             IssueReport[]
  commissions         Commission[]
  documents           AgentDocument[]
  documentVersions    AgentDocumentVersion[]
  memberCards         MemberCard[]
  customerInvites     CustomerInvite[]
  agentRewards        AgentReward[]
  ajoGroups           AjoGroup[]
}

model AgentDocument {
  id                 String    @id @default(cuid())
  agentId            String
  agent              Agent     @relation(fields: [agentId], references: [id])
  docType            String
  fileName           String
  fileData           String
  uploadedAt         DateTime  @default(now())
  docApprovalStatus  String    @default("pending")
  docApprovedAt      DateTime?
  docRejectionReason String?
  uploadedBy         String? // who supplied this file; empty on files from before this was recorded

  @@unique([agentId, docType])
}

/// A file that was replaced, kept when an AgentDocument is overwritten. The latest five per document are kept (agent-document-store.ts).
model AgentDocumentVersion {
  id                String   @id @default(cuid())
  agentId           String
  agent             Agent    @relation(fields: [agentId], references: [id])
  docType           String
  fileName          String
  fileData          String
  docApprovalStatus String
  uploadedAt        DateTime
  replacedAt        DateTime @default(now())
  replacedBy        String
  uploadedBy        String?

  @@index([agentId, docType])
}

model Customer {
  id                  String                @id @default(cuid())
  customerId          String                @unique
  agentId             String
  agent               Agent                 @relation(fields: [agentId], references: [id])
  referredBy          String?
  referrer            Customer?             @relation("Referrals", fields: [referredBy], references: [id])
  referrals           Customer[]            @relation("Referrals")
  kind                String                @default("Savings")
  firstName           String
  lastName            String
  phone               String
  email               String?
  emailVerifiedAt     DateTime? // set only when the customer proved the address; agent-entered emails stay null
  emailAlertsOn       Boolean               @default(true) // the customer's switch for sign-in and payment emails; only acts once the email is verified
  dob                 DateTime?
  address             String
  language            String                @default("English")
  gender              String?
  state               String?
  lga                 String?
  bvn                 String?
  nokName             String
  nokRelation         String
  nokPhone            String
  photoUrl            String?
  status              String                @default("Active")
  walletBalance       Float                 @default(0)
  password            String?
  inviteToken         String?               @unique
  tokenVersion        Int                   @default(0)
  /// When the customer last opened their notifications; newer ones count as new on the bell.
  notificationsSeenAt DateTime?
  boundDeviceId       String?
  createdAt           DateTime              @default(now())
  savingsPlans        SavingsPlan[]
  transactions        Transaction[]
  loans               Loan[]
  memberCards         MemberCard[]
  chatMessages        CustomerChatMessage[]
  customerPayments    CustomerPayment[]
  giftCardOrders      GiftCardOrder[]
  redeemedGiftCards   GiftCard[]            @relation("RedeemedBy")
  agentReward         AgentReward?
  ajoMemberships      AjoMember[]
}

/// A cash saver an agent wants to register. It only becomes a Customer when the super admin approves it.
model CustomerRequest {
  id              String    @id @default(cuid())
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id])
  status          String    @default("Pending") // Pending | Approved | Denied
  firstName       String
  lastName        String
  phone           String
  email           String?
  dob             DateTime?
  address         String
  language        String    @default("English")
  gender          String
  state           String
  lga             String
  bvn             String?
  nokName         String    @default("")
  nokRelation     String    @default("")
  nokPhone        String    @default("")
  /// Base64 data URL; never select it into a list. Cleared on approval, when it moves to the Customer.
  photoUrl        String?
  /// JSON array of RequestPlan (src/lib/customer-request.ts).
  plans           String
  nfcCard         String?
  registrationFee Float
  /// Set only while Pending, so two waiting requests can't hold the same phone or email, even in a race.
  pendingPhone    String?   @unique
  pendingEmail    String?   @unique
  denyReason      String?
  denyFix         String?
  decidedAt       DateTime?
  decidedBy       String?
  decidedById     String?
  customerCode    String?   @unique
  submittedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([status, submittedAt])
  @@index([agentId, status])
}

model SavingsPlan {
  id               String            @id @default(cuid())
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  dailyAmount      Float
  periodDays       Int
  cadence          String            @default("daily")
  source           String            @default("agent")
  goal             String
  startDate        DateTime
  maturityDate     DateTime
  balance          Float             @default(0)
  status           String            @default("Active")
  maturityNotified Boolean           @default(false)
  interestAccrued  Float             @default(0)
  /// New model: fee already taken from this plan (a daily plan stops at one day's amount).
  feeCollected     Float             @default(0)
  /// Set when a redeemed plan is reopened: interest counts only deposits made from this moment on. Null = whole life of the plan.
  cycleStartedAt   DateTime?
  notes            String?
  transactions     Transaction[]
  earlyRedemptions EarlyRedemption[]
  dayCoverages     PlanDayCoverage[]
}

model PlanDayCoverage {
  id            String      @id @default(cuid())
  savingsPlanId String
  savingsPlan   SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  coversKey     String // local 'YYYY-MM-DD'
  ref           String
  createdAt     DateTime    @default(now())

  @@unique([savingsPlanId, coversKey])
}

model Transaction {
  id          String       @id @default(cuid())
  ref         String       @unique
  agentId     String
  agent       Agent        @relation(fields: [agentId], references: [id])
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  planId      String?
  plan        SavingsPlan? @relation(fields: [planId], references: [id])
  type        String
  amount      Float
  method      String?      @default("Cash")
  status      String       @default("Done")
  note        String?
  walletAfter Float?
  /// New model: platform fee taken out of this deposit before it reached the plan balance.
  feeTaken    Float        @default(0)
  createdAt   DateTime     @default(now())
}

model Loan {
  id             String          @id @default(cuid())
  ref            String          @unique
  agentId        String
  agent          Agent           @relation(fields: [agentId], references: [id])
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  principal      Float
  interestRate   Float
  interestAmount Float
  totalAmount    Float
  durationDays   Int
  dueDate        DateTime
  status         String          @default("Pending")
  approvedBy     String?
  repayments     LoanRepayment[]
  createdAt      DateTime        @default(now())
}

model LoanRepayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id])
  amount    Float
  method    String   @default("Cash")
  createdAt DateTime @default(now())
}

model InterestRate {
  id           String  @id @default(cuid())
  durationDays Int     @unique
  label        String
  rate         Float
  maxAmount    Float?
  enabled      Boolean @default(true)
}

model SubAgent {
  id            String   @id @default(cuid())
  parentAgentId String
  parent        Agent    @relation(fields: [parentAgentId], references: [id])
  name          String
  phone         String   @unique
  location      String
  walletBalance Float    @default(0)
  createdAt     DateTime @default(now())
}

model Commission {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  month     Int
  year      Int
  amount    Float
  breakdown String?
  createdAt DateTime @default(now())

  @@unique([agentId, month, year])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PlatformWallet {
  id        String   @id @default(cuid())
  type      String   @unique
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
}

model SuperAdmin {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  approvalPin String?
  createdAt   DateTime @default(now())
}

model IssueReport {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  category    String
  title       String
  description String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
}

model PhoneOTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailOTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  actorType String   @default("agent")
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())
}

model StaffUser {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  password        String?
  status          String       @default("Invited")
  lastActiveAt    DateTime?
  createdAt       DateTime     @default(now())
  roleId          String?
  roleRef         Role?        @relation(fields: [roleId], references: [id])
  departmentId    String?
  department      Department?  @relation("DeptMembers", fields: [departmentId], references: [id])
  ledDepartments  Department[] @relation("DeptLead")
  approvalPin     String?
  inviteTokenHash String?
  inviteExpiresAt DateTime?
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  status      String      @default("Active")
  createdAt   DateTime    @default(now())
  roles       Role[]
  members     StaffUser[] @relation("DeptMembers")
  leadId      String?
  lead        StaffUser?  @relation("DeptLead", fields: [leadId], references: [id], onDelete: SetNull)
}

model Role {
  id           String      @id @default(cuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  name         String
  permissions  String      @default("[]")
  status       String      @default("Active")
  createdAt    DateTime    @default(now())
  staff        StaffUser[]

  @@unique([departmentId, name])
}

model EarlyRedemption {
  id                    String      @id @default(cuid())
  ref                   String      @unique
  savingsPlanId         String
  savingsPlan           SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  type                  String      @default("early")
  reason                String
  note                  String?
  status                String      @default("Pending")
  balance               Float
  penalty               Float       @default(0)
  interestAmount        Float       @default(0)
  netPayout             Float
  token                 String?     @unique
  tokenExpiry           DateTime?
  attempts              Int         @default(0)
  agentApprovedAt       DateTime?
  agentApprovedBy       String?
  payoutMethod          String      @default("Cash")
  accountNumber         String?
  accountName           String?
  bankCode              String?
  bankName              String?
  paystackRecipientCode String?
  paystackTransferCode  String?
  bankTransferStatus    String?
  requestedAt           DateTime    @default(now())
  decidedAt             DateTime?
  decidedBy             String?
  adminNote             String?
  /// 'v1' = fee split 3/5 agent, 2/5 platform (before go-live); 'v2' = fee is all platform, agent gets the catch-up.
  feeRule               String      @default("v1")
  /// The agent's part of `penalty` under feeRule v2, stored at request time.
  feeAgent              Float       @default(0)
}

model MemberCard {
  id         String    @id @default(cuid())
  serial     String    @unique
  batchName  String
  batchId    String
  expiryDate DateTime
  status     String    @default("Unlinked")
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id])
  linkedAt   DateTime?
  createdAt  DateTime  @default(now())
}

model CustomerInvite {
  id         String    @id @default(cuid())
  token      String    @unique
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id])
  plan       String?
  usedAt     DateTime?
  customerId String?
  createdAt  DateTime  @default(now())
}

model CustomerPayment {
  id         String   @id @default(cuid())
  ref        String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  planId     String?
  amount     Float
  status     String   @default("Pending")
  channel    String?
  createdAt  DateTime @default(now())
}

model CustomerChatMessage {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  sender     String
  senderId   String?
  senderName String?
  message    String
  imageUrl   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model BiometricToken {
  id         String    @id @default(cuid())
  agentId    String?
  customerId String?
  deviceId   String
  tokenHash  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([agentId, deviceId])
  @@index([customerId, deviceId])
  @@index([tokenHash])
}

model DeviceSession {
  id           String   @id @default(cuid())
  deviceId     String
  app          String // 'agent' | 'customer'
  agentId      String?
  customerId   String?
  platform     String? // 'android' | 'ios'
  model        String?
  manufacturer String?
  osVersion    String?
  appVersion   String?
  ipAddress    String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  loginCount   Int      @default(1)

  @@unique([deviceId, app])
  @@index([agentId])
  @@index([customerId])
  @@index([lastSeenAt])
}

model AgentInvite {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model GiftCardCategory {
  id             String          @id @default(cuid())
  name           String          @unique
  description    String?
  denominations  String          @default("[]")
  productionCost Float
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  orders         GiftCardOrder[]
}

model GiftCardOrder {
  id             String           @id @default(cuid())
  ref            String           @unique
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id])
  categoryId     String
  category       GiftCardCategory @relation(fields: [categoryId], references: [id])
  loadedAmount   Float
  productionCost Float
  totalPaid      Float
  quantity       Int              @default(1)
  status         String           @default("PendingPayment")
  paystackRef    String?          @unique
  paidAt         DateTime?
  producedAt     DateTime?
  producedBy     String?
  shippedAt      DateTime?
  createdAt      DateTime         @default(now())
  cards          GiftCard[]

  @@index([status])
  @@index([customerId])
}

model GiftCard {
  id                   String        @id @default(cuid())
  serial               String        @unique
  qrToken              String        @unique
  orderId              String
  order                GiftCardOrder @relation(fields: [orderId], references: [id])
  issuerCustomerId     String
  loadedAmount         Float
  balance              Float
  status               String        @default("Produced")
  redeemedByCustomerId String?
  redeemedBy           Customer?     @relation("RedeemedBy", fields: [redeemedByCustomerId], references: [id])
  redeemedAt           DateTime?
  createdAt            DateTime      @default(now())

  @@index([status])
  @@index([issuerCustomerId])
}

model GiftCardInvite {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String
  name       String?
  status     String   @default("Pending")
  customerId String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model AgentWithdrawal {
  id                    String    @id @default(cuid())
  ref                   String    @unique
  agentId               String
  amount                Float
  note                  String?
  status                String    @default("Pending")
  payoutMethod          String    @default("BankTransfer")
  bankCode              String?
  bankName              String?
  accountNumber         String?
  accountName           String?
  paystackRecipientCode String?
  paystackTransferCode  String?
  bankTransferStatus    String?
  adminNote             String?
  requestedAt           DateTime  @default(now())
  decidedAt             DateTime?
  decidedBy             String?

  @@index([agentId])
  @@index([status])
}

model RewardPromo {
  id                  String        @id @default(cuid())
  name                String        @default("Registration Reward")
  startDate           DateTime
  endDate             DateTime
  offlineRewardAmount Float         @default(200)
  onlineRewardAmount  Float         @default(500)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  rewards             AgentReward[]
}

model AgentReward {
  id         String      @id @default(cuid())
  agentId    String
  agent      Agent       @relation(fields: [agentId], references: [id])
  customerId String      @unique
  customer   Customer    @relation(fields: [customerId], references: [id])
  promoId    String
  promo      RewardPromo @relation(fields: [promoId], references: [id])
  type       String
  amount     Float
  narration  String      @default("Reward fee")
  createdAt  DateTime    @default(now())

  @@index([agentId])
}

// Brute-force throttle state for the customer login path. One row per throttle
// key: "phone:<normalised phone>" (per-account escalation) or "ip:<addr>"
// (loose per-IP spray rule). Managed by src/lib/login-attempt.ts; the decision
// logic lives in src/lib/login-throttle.ts.
model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  failCount   Int       @default(0)
  lastFailAt  DateTime?
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// One-time codes for unlocking a hard-locked customer account. The code itself
// is never stored or returned — only a SHA-256 hash. Sent on the customer's
// registration channel: email (link-registered) or SMS (agent-registered).
model AccountUnlockOtp {
  id         String    @id @default(cuid())
  customerId String
  channel    String // 'email' | 'sms'
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// Password-reset and agent-unlock codes. Only the hash is stored, and rows are
// consumed rather than deleted so the send cooldown and daily cap keep counting.
model PasswordResetOtp {
  id            String    @id @default(cuid())
  actorType     String // 'customer' | 'agent'
  actorId       String
  purpose       String    @default("reset") // 'reset' | 'unlock' | 'admin'
  resetId       String? // given only to whoever requested this code; guesses must present it
  requestIpHash String? // keyed hash of the requester's IP, for the per-account-and-IP send limits
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([actorType, actorId, createdAt])
  @@index([resetId])
}

// Server-side payment intent created at Paystack init, consumed at verify. Binds
// a payment reference to the actor, plan and amount it was initiated for, so a
// verify cannot claim an arbitrary reference or credit a mismatched amount.
model PaymentIntent {
  id          String    @id @default(cuid())
  ref         String    @unique
  actorType   String // 'agent' | 'customer'
  agentId     String?
  customerId  String?
  planId      String?
  amount      Float
  currency    String    @default("NGN")
  status      String    @default("Pending") // Pending | Done
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?
  coversKeys  String? // JSON array of day-keys
  /// 'paystack' | 'transfer'. A transfer intent's amount carries a unique kobo and it closes at expiresAt.
  method      String    @default("paystack")
  expiresAt   DateTime?
  /// Set when staff credited this by hand: the admin's name and the reason they gave.
  manualBy    String?
  manualNote  String?
  /// Set when this transfer pays an Ajo round instead of a plan: the member and the round it pays.
  ajoMemberId String?
  ajoRound    Int?

  @@index([customerId])
  @@index([agentId])
}

/// A Moniepoint credit alert read from the mailbox. messageId and txnId are unique so one transfer credits once.
model BankAlert {
  id           String    @id @default(cuid())
  messageId    String    @unique
  txnId        String    @unique
  amount       Float
  senderName   String
  narration    String
  alertAt      DateTime
  status       String // Matched | Unmatched | Resolved | Dismissed
  intentRef    String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedNote String?
}

model SavingsInterestRate {
  id            String   @id @default(cuid())
  annualRate    Float
  effectiveFrom DateTime @default(now())
  createdBy     String?
  createdAt     DateTime @default(now())
}

model AutoDebitMandate {
  id                  String   @id @default(cuid())
  customerId          String
  savingsPlanId       String   @unique
  channel             String   @default("card")
  authorizationCode   String
  authSignature       String
  authEmail           String
  reusable            Boolean  @default(false)
  last4               String?
  cardType            String?
  bankName            String?
  expMonth            String?
  expYear             String?
  status              String   @default("pending")
  amountPerCycle      Float
  nextRunAt           DateTime
  consecutiveFailures Int      @default(0)
  consentAt           DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, nextRunAt])
}

model AutoDebitAttempt {
  id              String   @id @default(cuid())
  mandateId       String
  savingsPlanId   String
  reference       String   @unique
  cycleDate       DateTime
  creditAmount    Float
  grossCharged    Float
  feeEstimate     Float
  settledAmount   Float?
  status          String   @default("pending")
  gatewayResponse String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

/// In-app notifications for agents and customers. Written in the same transaction as the change it describes, through the
/// catalogue in src/lib/notifications.ts only. dedupeKey makes retries and the nightly safety net harmless.
model Notification {
  id            String   @id @default(cuid())
  recipientType String // 'agent' | 'customer'
  recipientId   String
  kind          String
  title         String
  body          String?
  href          String?
  dedupeKey     String   @unique
  createdAt     DateTime @default(now())

  @@index([recipientType, recipientId, createdAt])
}

model NotificationLog {
  id         String   @id @default(cuid())
  customerId String
  kind       String
  periodKey  String
  sentAt     DateTime @default(now())

  @@unique([customerId, kind, periodKey])
}

model ApprovalPinAttempt {
  id          String   @id @default(cuid())
  adminId     String   @unique
  windowStart DateTime @default(now())
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// Append-only record of every commission and platform fee. Never updated or deleted.
model CommissionLedger {
  id         String   @id @default(cuid())
  party      String // 'agent' | 'platform'
  agentId    String?
  source     String // 'savings' | 'savings_catchup' | 'loan' | 'repayment' | 'redemption_fee'
  sourceRef  String
  customerId String?
  base       Float
  ratePct    Float
  amount     Float
  createdAt  DateTime @default(now())

  @@unique([source, sourceRef, party])
  @@index([agentId, createdAt])
  @@index([party, createdAt])
}

// A pop-up message super admin shows to agents and/or customers every time they sign in or open the app, until its
// end date. A dismissal row only counts who has closed it; it doesn't stop it showing.
model Announcement {
  id         String                  @id @default(cuid())
  title      String
  body       String
  audience   String // 'agents' | 'customers' | 'both'
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean                 @default(true)
  createdBy  String?
  createdAt  DateTime                @default(now())
  dismissals AnnouncementDismissal[]
  images     AnnouncementImage[]

  @@index([isActive, endsAt])
}

// A picture on a pop-up message, stored as raw bytes and served by link so opening the app never loads them twice.
// announcementId is empty between uploading a picture and saving the message.
model AnnouncementImage {
  id             String        @id @default(cuid())
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  position       Int           @default(0)
  mime           String
  data           Bytes
  createdAt      DateTime      @default(now())

  @@index([announcementId, position])
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  recipientType  String // 'agent' | 'customer'
  recipientId    String
  dismissedAt    DateTime     @default(now())

  @@unique([announcementId, recipientType, recipientId])
}

// Ajo (rotating group savings). An agent creates a group; members (the agent's own customers) each pay the
// contribution every round, and when every member has paid a round, that round's slot holder gets the whole pot as an
// ended payout plan (SavingsPlan cadence 'ajo') that they collect through the normal collection flow.
model AjoGroup {
  id               String            @id @default(cuid())
  /// Six digits, from node:crypto. Only usable while the group is Forming.
  code             String            @unique
  name             String
  agentId          String
  agent            Agent             @relation(fields: [agentId], references: [id])
  cadence          String // 'daily' | 'weekly' | 'monthly'
  size             Int
  contribution     Float
  /// Round 1 is due on this Lagos day; round N one day/week/month later each.
  startDate        DateTime
  status           String            @default("Forming") // Forming | Running | Completed | Cancelled
  /// Fee taken from each pot; 'none' until the owner decides.
  feeRule          String            @default("none")
  /// Platform Fee rate, locked when the group starts: % of each pot, and the agent's % of that fee.
  feePct           Float             @default(0)
  feeAgentSharePct Float             @default(0)
  lockedAt         DateTime?
  completedAt      DateTime?
  /// Set when staff stop a running group and refund its open turn (status Stopped).
  stoppedAt        DateTime?
  stopReason       String?
  createdAt        DateTime          @default(now())
  members          AjoMember[]
  contributions    AjoContribution[]
  payouts          AjoPayout[]

  @@index([agentId])
}

model AjoMember {
  id               String            @id @default(cuid())
  groupId          String
  group            AjoGroup          @relation(fields: [groupId], references: [id])
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  /// The round this member collects. While forming, the place the agent has arranged (null until then); fixed when the group starts.
  slot             Int?
  joinedAt         DateTime          @default(now())
  /// Set when staff replaced this member: who they replaced and what that person had paid in. It comes out of this
  /// turn's pot and goes back to them.
  owedToCustomerId String?
  owedAmount       Float             @default(0)
  replacedAt       DateTime?
  contributions    AjoContribution[]

  @@unique([groupId, customerId])
  @@unique([groupId, slot])
  @@index([customerId])
}

/// The pool ledger: one row per member per round, never more.
model AjoContribution {
  id           String    @id @default(cuid())
  groupId      String
  group        AjoGroup  @relation(fields: [groupId], references: [id])
  memberId     String
  member       AjoMember @relation(fields: [memberId], references: [id])
  round        Int
  amount       Float
  method       String // 'transfer' | 'cash'
  ref          String    @unique
  /// The agent who took the cash, for cash contributions.
  agentId      String?
  /// Set when staff stopped the group: the plan holding this payment for its payer to collect.
  refundPlanId String?
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([memberId, round])
  @@index([groupId, round])
}

/// One payout per round: the pot moved into the slot holder's payout plan.
model AjoPayout {
  id            String   @id @default(cuid())
  groupId       String
  group         AjoGroup @relation(fields: [groupId], references: [id])
  round         Int
  memberId      String
  amount        Float
  savingsPlanId String   @unique
  createdAt     DateTime @default(now())

  @@unique([groupId, round])
}
